load mgsim
load ./ota.so
verilog
ground gnd;
ota DUT(inp, inn, out);
spice
Vref inn gnd 0.9
Vdiff inp inn DC 0 AC 1 PULSE(0 10u 2u 20n 20n 16u 40u)

.print dc v(inp) v(inn) v(out)
.dc Vdiff -10u 10u 10u > results/ota_dc.txt

.print ac vm(out)
.ac 100 1Meg decade 100 > results/ota_ac.txt

.print tran v(inp) v(inn) v(out)
.tran 0 30u 20n > results/ota_tran.txt
